// Civic 89 resources. SPDX-License-Identifier: GPL-3.0-or-later
#include <winres.h>
102 ICON "@CMAKE_SOURCE_DIR@/assets/branding/civic89.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Civic 89"
   VALUE "FileVersion", "@CIVIC89_VERSION@+@CIVIC89_REVISION@"
   VALUE "InternalName", "civic89"
   VALUE "OriginalFilename", "civic89.exe"
   VALUE "ProductName", "Civic 89"
   VALUE "ProductVersion", "@CIVIC89_VERSION@"
   VALUE "LegalCopyright", "1989-2007 Electronic Arts; 2022-2026 Leeor Dicker; 2026 Civic 89 contributors"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
