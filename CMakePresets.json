{
  "version": 6,
  "cmakeMinimumRequired": { "major": 4, "minor": 2, "patch": 0 },
  "configurePresets": [
    {
      "name": "base-windows-x64",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_MODE": "ON",
        "CMAKE_VS_GLOBALS": "VcpkgEnabled=false;VcpkgEnableManifest=false",
        "BUILD_TESTING": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-x64-debug",
      "inherits": "base-windows-x64",
      "cacheVariables": { "CMAKE_CONFIGURATION_TYPES": "Debug" }
    },
    {
      "name": "windows-x64-release",
      "inherits": "base-windows-x64",
      "cacheVariables": { "CMAKE_CONFIGURATION_TYPES": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "windows-x64-debug", "configurePreset": "windows-x64-debug", "configuration": "Debug" },
    { "name": "windows-x64-release", "configurePreset": "windows-x64-release", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "windows-x64-debug", "configurePreset": "windows-x64-debug", "configuration": "Debug",
      "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" }
    },
    {
      "name": "windows-x64-release", "configurePreset": "windows-x64-release", "configuration": "Release",
      "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" }
    }
  ]
}
